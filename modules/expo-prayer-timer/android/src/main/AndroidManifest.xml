<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Fired by the notification's "End prayer" button. Static so it works
         even if the app process was killed while praying. -->
    <receiver
      android:name="expo.modules.prayertimer.PrayerTimerEndReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="expo.modules.prayertimer.END_PRAYER" />
      </intent-filter>
    </receiver>
    <!-- Fired by the notification's "Pray" button: advances to the next person. -->
    <receiver
      android:name="expo.modules.prayertimer.PrayerTimerPrayReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="expo.modules.prayertimer.PRAY_NEXT" />
      </intent-filter>
    </receiver>
    <!-- Fired by the emergency notification's "Dismiss" button. -->
    <receiver
      android:name="expo.modules.prayertimer.EmergencyDismissReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="expo.modules.prayertimer.DISMISS_EMERGENCY" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
