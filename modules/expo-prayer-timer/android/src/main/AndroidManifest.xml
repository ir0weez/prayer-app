<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Fired by the notification's "End prayer" button. Static so it works
         even if the app process was killed while praying. -->
    <receiver
      android:name="expo.modules.prayertimer.PrayerTimerEndReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="expo.modules.prayertimer.END_PRAYER" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
