      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widgetprovider_upnext" />
    </receiver>
    <receiver
      android:name="expo.modules.prayercirclewidgets.YourStudyWidgetProvider"
      android:exported="true"
      android:label="@string/widget_your_study_label">
