<?xml version="1.0" encoding="utf-8"?>
<!-- v443: the Emergency Strip's red field — the main Emergency
     widget's own gradient (#B91C1C -> #7F1D1D, top-left to
     bottom-right; a meaning hue, never device-tinted) at the
     strips' 24dp radius instead of the big card's 28dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
  <gradient
    android:type="linear"
    android:angle="315"
    android:startColor="#B91C1C"
    android:endColor="#7F1D1D" />
  <corners android:radius="24dp" />
</shape>
