<?xml version="1.0" encoding="utf-8"?>
<!-- Emergency Strip (v443, ES-1 · Face first) — the emergency
     snapshot in a true 2×1 cell (~190×82dp): the main widget's
     red (widget_bg_emergency_24 — the meaning hue, never tinted)
     when something is burning, the pale palette surface when not.
     v447 (Jonathan, Nov 5, on the v446 render): "Just get rid
     of the 'pray now' button altogether. Just show the name.
     And the avatar." The strip is now AVATAR + NAME ONLY — no
     Pray now pill in either composition, no need line under the
     name, no per-row tap: the whole card's tap (which opens the
     lead emergency) is the only tap, exactly as the quiet face
     already worked. The big Emergency widget and the in-app
     card keep their Pray now buttons and hours text; this is
     the strip only. What survives of the compositions: the
     single face's 54dp avatar at the left (ring 54, image 50,
     initials 17sp) with the name on its own full-width line in
     the weighted column beside it, vertically centred now that
     it stands alone; the two-active rows keep their 28dp faces
     and 14sp names, hairline between them.
     v446 (Jonathan, Nov 5: "you can probably make the avatar a
     bit bigger. I also want the name to fit."): the single face
     was recomposed — the avatar stands 54dp at the left and the
     name got its own full-width line in the weighted column
     beside it (≈ 101dp — the widest it has ever had on this
     strip). v447 keeps that composition; the need line and the
     pill row that stood under the name are gone.
     v445 (his rulings, Nov 5): the hours-left chip was REMOVED
     from the strip entirely ("it doesn't need the little hours
     left chip. Not in the widget anyway."), and the two-active
     lines lost their "· {hours} left" suffix with it.
     XML defaults are the quiet face. Vanilla subset only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/es_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/es_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_24" />

  <ImageView
    android:id="@+id/es_bg_red"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_bg_emergency_24"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <!-- Quiet face -->
    <LinearLayout
      android:id="@+id/es_quiet"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="vertical">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/es_q_dot"
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#7A72A0" />

        <TextView
          android:id="@+id/es_q_kicker"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="7dp"
          android:letterSpacing="0.14"
          android:text="EMERGENCY"
          android:textColor="#7A72A0"
          android:textSize="10sp"
          android:textStyle="bold" />
      </LinearLayout>

      <TextView
        android:id="@+id/es_q_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="No emergencies"
        android:textColor="#221A3E"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/es_q_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Nothing urgent right now."
        android:textColor="#4A4270"
        android:textSize="12sp" />
    </LinearLayout>

    <!-- One active (v447: avatar + name only — the 54dp avatar
         stands at the left; the weighted column beside it holds
         the name alone, centred against the avatar) -->
    <LinearLayout
      android:id="@+id/es_single"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <ImageView
          android:id="@+id/es_s_ring"
          android:layout_width="54dp"
          android:layout_height="54dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#FFFFFF" />

        <ImageView
          android:id="@+id/es_s_img"
          android:layout_width="50dp"
          android:layout_height="50dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/es_s_text"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="17sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
          android:id="@+id/es_s_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:singleLine="true"
          android:textColor="#FFFFFF"
          android:textSize="15.5sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

    <!-- Two or more active (v447: each row is avatar + name
         only, soonest first; further emergencies ride the
         card tap into the app, as the quiet face does) -->
    <LinearLayout
      android:id="@+id/es_multi"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:visibility="gone">

      <LinearLayout
        android:id="@+id/es_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
          android:layout_width="28dp"
          android:layout_height="28dp">

          <ImageView
            android:id="@+id/es_m_img_1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/es_m_text_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/es_m_name_1"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/es_hairline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2EFFFFFF" />

      <LinearLayout
        android:id="@+id/es_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
          android:layout_width="28dp"
          android:layout_height="28dp">

          <ImageView
            android:id="@+id/es_m_img_2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/es_m_text_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/es_m_name_2"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
