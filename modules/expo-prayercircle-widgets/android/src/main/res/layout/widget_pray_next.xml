<?xml version="1.0" encoding="utf-8"?>
<!-- Pray Next (v443, R-2 recomposed at 2×1; v441 W-3 before) —
     the rectangle given to one person, in a true 2×1 cell
     (~190×82dp): the next person's face (44dp, primary ring),
     their name and a quiet status line, and the filled Pray now
     pill. FIT is the composition's law: the name column is
     layout_weight-constrained AHEAD of the pill and the pill is
     wrap_content (a pill ImageView stretched over a wrap frame
     by its padded label), so the pill can never run off the edge
     the way the v441 fixed 96dp frame did at small sizes — the
     name ellipsizes first. The v441 kicker and need line are
     gone: at strip size the name + status carry the card.
     XML defaults are the quiet face in Classic-light values.
     Vanilla subset only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pn_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/pn_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_24" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
      android:id="@+id/pn_msg"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/pn_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open PrayerCircle"
        android:textColor="#221A3E"
        android:textSize="15sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pn_msg_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Today's prayer list will stand here."
        android:textColor="#4A4270"
        android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/pn_hero"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
          android:id="@+id/pn_ring"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#6D4BD8" />

        <ImageView
          android:id="@+id/pn_img"
          android:layout_width="44dp"
          android:layout_height="44dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/pn_text"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/pn_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="15.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pn_status"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:text="Waiting"
          android:textColor="#7A72A0"
          android:textSize="11.5sp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/pn_pill_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp">

        <ImageView
          android:id="@+id/pn_pill_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white"
          android:tint="#6D4BD8" />

        <TextView
          android:id="@+id/pn_pill"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:paddingStart="15dp"
          android:paddingTop="8dp"
          android:paddingEnd="15dp"
          android:paddingBottom="8dp"
          android:text="Pray now"
          android:textColor="#FFFFFF"
          android:textSize="13.5sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
