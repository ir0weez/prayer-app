<?xml version="1.0" encoding="utf-8"?>
<!-- Pray Next (v441, W-3 R-2) — the rectangle given to one person:
     their face big at the left (62dp, ringed in the seed), the
     NEXT UP kicker, name and need, and a filled Pray now pill at
     the right. The pill is a FIXED-size frame (96x38dp) holding a
     tinted pill ImageView under a centred TextView — the text is a
     constant, so the frame never depends on wrap_content measuring
     a match_parent child (the v438 pill collapse). Dress arrives
     in the snapshot's palette; XML defaults are the quiet face in
     the W-3 Classic-light values. Vanilla subset only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pn_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/pn_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:src="@drawable/widget_shape_white" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
      android:id="@+id/pn_msg"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/pn_msg_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open PrayerCircle"
        android:textColor="#221A3E"
        android:textSize="16sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pn_msg_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Today's prayer list will stand here."
        android:textColor="#4A4270"
        android:textSize="12.5sp" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/pn_hero"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp">

        <ImageView
          android:id="@+id/pn_ring"
          android:layout_width="68dp"
          android:layout_height="68dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#6D4BD8" />

        <ImageView
          android:id="@+id/pn_img"
          android:layout_width="62dp"
          android:layout_height="62dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/pn_text"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="20sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/pn_kicker"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:letterSpacing="0.13"
          android:text="NEXT UP"
          android:textColor="#6D4BD8"
          android:textSize="10.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pn_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="20sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pn_need"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="2"
          android:textColor="#4A4270"
          android:textSize="13sp" />
      </LinearLayout>

      <FrameLayout
        android:layout_width="96dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp">

        <ImageView
          android:id="@+id/pn_pill_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white"
          android:tint="#6D4BD8" />

        <TextView
          android:id="@+id/pn_pill"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:text="Pray now"
          android:textColor="#FFFFFF"
          android:textSize="12.5sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
