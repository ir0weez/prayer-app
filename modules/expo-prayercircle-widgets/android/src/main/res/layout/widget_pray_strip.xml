          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="10.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/ps_face_state_5"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:letterSpacing="0.06"
          android:textColor="#7A72A0"
          android:textSize="8sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/ps_face_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="46dp"
          android:layout_height="46dp">

          <ImageView
            android:id="@+id/ps_face_ring_6"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white"
            android:tint="#E6DEF9" />

          <ImageView
            android:id="@+id/ps_face_img_6"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/ps_face_text_6"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#2A1666"
            android:textSize="12sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/ps_face_name_6"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="10.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/ps_face_state_6"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:letterSpacing="0.06"
          android:textColor="#7A72A0"
          android:textSize="8sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
