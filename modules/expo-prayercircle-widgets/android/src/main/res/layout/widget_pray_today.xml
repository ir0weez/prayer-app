<?xml version="1.0" encoding="utf-8"?>
<!-- Pray Today — 4x2 flagship. The XML defaults ARE the quiet face
     ("Open PrayerCircle"): a fresh placement renders this compiled
     layout before any snapshot exists, so it can never be blank.
     The provider (WidgetRenderer) fills the hero/faces from the
     snapshot JSON and toggles the fixed slots by visibility. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pt_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/widget_circle_white"
      android:tint="#A78BFA" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:letterSpacing="0.14"
      android:text="PRAY TODAY"
      android:textColor="#AAA2C6"
      android:textSize="11sp"
      android:textStyle="bold" />

    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />

    <TextView
      android:id="@+id/pt_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="#AAA2C6"
      android:textSize="11.5sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/pt_msg_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Open PrayerCircle"
    android:textColor="#F4F1FD"
    android:textSize="17sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/pt_msg_sub"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="Today's prayer list will stand here."
    android:textColor="#AAA2C6"
    android:textSize="13sp" />

  <LinearLayout
    android:id="@+id/pt_hero"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <FrameLayout
      android:layout_width="54dp"
      android:layout_height="54dp">

      <ImageView
        android:id="@+id/pt_avatar_img"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#7A4FD0" />

      <TextView
        android:id="@+id/pt_avatar_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/pt_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.11"
        android:maxLines="1"
        android:textColor="#AAA2C6"
        android:textSize="10.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pt_need"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#F4F1FD"
        android:textSize="18sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pt_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#D8D2F2"
        android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
      android:id="@+id/pt_pill"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:background="@drawable/widget_pill_seed"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="14dp"
      android:paddingBottom="8dp"
      android:text="Pray now"
      android:textColor="#1D1430"
      android:textSize="12.5sp"
      android:textStyle="bold" />
  </LinearLayout>


  <LinearLayout
    android:id="@+id/pt_faces"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <!-- Six fixed face slots (the classic RemoteViews pattern — the
         provider fills/toggles them; a 7th+ face folds into slot 6
         as a +N counter). Generated per slot: ring, face, initials,
         name, state. Slot 1 is written out; slots 2-6 share its
         shape with their own ids. -->
    <LinearLayout
      android:id="@+id/pt_face_1"
      android:layout_width="48dp"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp">

        <ImageView
          android:id="@+id/pt_face_ring_1"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#4A3D78" />

        <ImageView
          android:id="@+id/pt_face_img_1"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/pt_face_text_1"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="8sp"
          android:textStyle="bold" />
      </FrameLayout>

      <TextView
        android:id="@+id/pt_face_name_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#AAA2C6"
        android:textSize="9.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pt_face_state_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:textColor="#8D84B3"
        android:textSize="8.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/pt_face_2"
      android:layout_width="48dp"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
