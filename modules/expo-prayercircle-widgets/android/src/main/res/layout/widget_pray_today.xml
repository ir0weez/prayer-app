<?xml version="1.0" encoding="utf-8"?>
<!-- Pray Today — 4x2 flagship, v442 redesign (W-4 D-1, Material 3
     Expressive register). Dress arrives as the renderer's
     EFFECTIVE palette (device Material You colours first, the
     snapshot palette as fallback): pt_bg is a white shape the
     renderer paints with the palette surface, and every text /
     ring / pill colour is set at render. The XML defaults are
     the quiet face in the Classic-light values, so a fresh
     placement reads right before any push. Vanilla subset only
     (v439 rules): LinearLayout / FrameLayout / ImageView /
     TextView + <shape> drawables. The day bar is an ImageView —
     the renderer draws it in-process (barBitmap) like the v439
     glyphs; no progress-bar element exists. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/pt_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/pt_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_28"
    android:tint="#F7F3FE" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/pt_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#6D4BD8" />

      <TextView
        android:id="@+id/pt_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="PRAY TODAY"
        android:textColor="#7A72A0"
        android:textSize="11sp"
        android:textStyle="bold" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <TextView
        android:id="@+id/pt_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7A72A0"
        android:textSize="11.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/pt_msg_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Open PrayerCircle"
      android:textColor="#221A3E"
      android:textSize="17sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/pt_msg_sub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Today's prayer list will stand here."
      android:textColor="#4A4270"
      android:textSize="13sp" />

    <LinearLayout
      android:id="@+id/pt_hero"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <ImageView
          android:id="@+id/pt_avatar_ring"
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#6D4BD8" />

        <ImageView
          android:id="@+id/pt_avatar_img"
          android:layout_width="54dp"
          android:layout_height="54dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/pt_avatar_text"
          android:layout_width="54dp"
          android:layout_height="54dp"
          android:layout_gravity="center"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="17sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/pt_who"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:letterSpacing="0.13"
          android:maxLines="1"
          android:textColor="#6D4BD8"
          android:textSize="10.5sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pt_need"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="23sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pt_line"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#4A4270"
          android:textSize="13.5sp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/pt_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="10dp">

        <ImageView
          android:id="@+id/pt_pill_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:id="@+id/pt_pill_text"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center"
          android:paddingStart="20dp"
          android:paddingEnd="20dp"
          android:text="Pray now"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>

    <ImageView
      android:id="@+id/pt_daybar"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="12dp"
      android:contentDescription="@null"
      android:scaleType="fitXY"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/pt_faces"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:orientation="horizontal"
      android:visibility="gone">

      <!-- Six face slots spread across the card (weight 1 each):
           ring, face, initials, name, state — generated per slot;
           slot 1 is written out, slots 2-6 share its shape. A 7th+
           face folds into slot 6 as the +N counter. -->
      <LinearLayout
        android:id="@+id/pt_face_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="46dp"
          android:layout_height="46dp">

          <ImageView
            android:id="@+id/pt_face_ring_1"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white"
            android:tint="#F7F3FE" />

          <ImageView
            android:id="@+id/pt_face_img_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/pt_face_text_1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/pt_face_name_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="11sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/pt_face_state_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:letterSpacing="0.06"
          android:textColor="#7A72A0"
          android:textSize="8.5sp"
          android:textStyle="bold" />
      </LinearLayout>

<LinearLayout
