        <ImageView
          android:id="@+id/pt_face_ring_3"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#4A3D78" />

        <ImageView
          android:id="@+id/pt_face_img_3"
          android:layout_width="28dp"
