          android:textStyle="bold" />
      </FrameLayout>

      <TextView
        android:id="@+id/pt_face_name_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#AAA2C6"
        android:textSize="9.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/pt_face_state_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:textColor="#8D84B3"
        android:textSize="8.5sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/pt_face_6"
      android:layout_width="48dp"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp">

        <ImageView
          android:id="@+id/pt_face_ring_6"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white"
          android:tint="#4A3D78" />

        <ImageView
          android:id="@+id/pt_face_img_6"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_gravity="center"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/pt_face_text_6"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
