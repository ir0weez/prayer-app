<?xml version="1.0" encoding="utf-8"?>
<!-- Due to Reach Out — v442 redesign (W-4 D-4). The card wears
     the effective palette's surface now (the v438 deep-green
     dress is retired); the reached GREEN survives as the meaning
     colour on the dot, the due chip and the Reach out button —
     the snapshot palette's green family, never the device
     palette's. XML defaults are the quiet face in the
     Classic-light values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/reach_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/reach_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_28"
    android:tint="#F7F3FE" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/reach_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#2E7D46" />

      <TextView
        android:id="@+id/reach_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="DUE TO REACH OUT"
        android:textColor="#7A72A0"
        android:textSize="11sp"
        android:textStyle="bold" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <FrameLayout
        android:id="@+id/reach_due_wrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <ImageView
          android:id="@+id/reach_due_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:id="@+id/reach_due"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="10dp"
          android:paddingTop="4dp"
          android:paddingEnd="10dp"
          android:paddingBottom="4dp"
          android:textColor="#2E7D46"
          android:textSize="12sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/reach_msg_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Nobody due"
      android:textColor="#221A3E"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/reach_msg_sub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Everyone's been reached lately."
      android:textColor="#4A4270"
      android:textSize="12.5sp" />

    <LinearLayout
      android:id="@+id/reach_lead"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="13dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
          android:id="@+id/reach_avatar_img"
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/reach_avatar_text"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="16sp"
          android:textStyle="bold" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/reach_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="20sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/reach_since"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#4A4270"
          android:textSize="13sp" />
      </LinearLayout>

      <FrameLayout
        android:id="@+id/reach_btn"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="10dp">

        <ImageView
          android:id="@+id/reach_btn_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:id="@+id/reach_btn_text"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center"
          android:paddingStart="18dp"
          android:paddingEnd="18dp"
          android:text="Reach out"
          android:textColor="#2E7D46"
          android:textSize="14sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>

    <FrameLayout
      android:id="@+id/reach_hairline"
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginTop="13dp"
      android:background="#E0D8F5"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/reach_second"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="11dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp">

        <ImageView
          android:id="@+id/reach_second_img"
          android:layout_width="34dp"
          android:layout_height="34dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_circle_white" />

        <TextView
          android:id="@+id/reach_second_text_init"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#FFFFFF"
          android:textSize="10sp"
          android:textStyle="bold" />
      </FrameLayout>

      <TextView
        android:id="@+id/reach_second_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#221A3E"
        android:textSize="13.5sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/reach_second_rest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#4A4270"
        android:textSize="13.5sp" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <TextView
        android:id="@+id/reach_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7A72A0"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
