<?xml version="1.0" encoding="utf-8"?>
<!-- Due to Reach Out — half-width, deep green dress. XML defaults
     are the quiet face ("Nobody due"). The lead slot shows the most
     overdue person; the second slot rides under it when two are
     due, the way his contacts widget pairs faces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/reach_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_reach"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/widget_circle_white"
      android:tint="#7FC98F" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:letterSpacing="0.14"
      android:text="DUE TO REACH OUT"
      android:textColor="#9FC4A8"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/reach_msg_title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Nobody due"
    android:textColor="#F4F1FD"
    android:textSize="15sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/reach_msg_sub"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="Everyone's been reached lately."
    android:textColor="#B9CDBD"
    android:textSize="12sp" />

  <LinearLayout
    android:id="@+id/reach_lead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <FrameLayout
      android:layout_width="40dp"
      android:layout_height="40dp">

      <ImageView
        android:id="@+id/reach_avatar_img"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white" />

      <TextView
        android:id="@+id/reach_avatar_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/reach_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F4F1FD"
        android:textSize="22sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/reach_since"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B9CDBD"
        android:textSize="12sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/reach_second"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:visibility="gone">

    <FrameLayout
      android:layout_width="24dp"
      android:layout_height="24dp">

      <ImageView
        android:id="@+id/reach_second_img"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white" />

      <TextView
        android:id="@+id/reach_second_text_init"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="8sp"
        android:textStyle="bold" />
    </FrameLayout>

    <TextView
      android:id="@+id/reach_second_text"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#D8E8DB"
      android:textSize="12sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/reach_more"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="8dp"
      android:textColor="#9FC4A8"
      android:textSize="11.5sp" />
  </LinearLayout>
</LinearLayout>
