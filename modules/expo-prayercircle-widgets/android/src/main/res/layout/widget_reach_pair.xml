<?xml version="1.0" encoding="utf-8"?>
<!-- Reach Pair (v441, W-3 R-3) — the two most overdue people side
     by side, closest to his contacts rectangle: face, name, and a
     tonal-green "{days} days" chip under each. The chips are
     FIXED-size frames (bounded text, centred) holding a tinted
     pill ImageView under the label — no wrap_content frame ever
     measures a match_parent child. When only one person is due,
     the second column hides and the two spacer columns show, so
     the lead stands in the middle half. Dress arrives in the
     snapshot's palette (greens = the reached kind-tone); XML
     defaults are the quiet face in the W-3 Classic-light values.
     Vanilla subset only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rp_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/rp_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:src="@drawable/widget_shape_white" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/rp_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#2E7D46" />

      <TextView
        android:id="@+id/rp_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="DUE TO REACH OUT"
        android:textColor="#7A72A0"
        android:textSize="11sp"
        android:textStyle="bold" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <FrameLayout
        android:id="@+id/rp_due_wrap"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:visibility="gone">

        <ImageView
          android:id="@+id/rp_due_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white"
          android:tint="#DFF0E4" />

        <TextView
          android:id="@+id/rp_due"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:textColor="#2E7D46"
          android:textSize="11.5sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/rp_msg_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Nobody due"
      android:textColor="#221A3E"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/rp_msg_sub"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:text="Everyone's been reached lately."
      android:textColor="#4A4270"
      android:textSize="12sp" />

    <LinearLayout
      android:id="@+id/rp_pair"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_marginTop="8dp"
      android:layout_weight="1"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:id="@+id/rp_sp_1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />

      <LinearLayout
        android:id="@+id/rp_col_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="52dp"
          android:layout_height="52dp">

          <ImageView
            android:id="@+id/rp_img_1"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/rp_text_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/rp_name_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="14sp"
          android:textStyle="bold" />

        <FrameLayout
          android:layout_width="84dp"
          android:layout_height="24dp"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="5dp">

          <ImageView
            android:id="@+id/rp_chip_img_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_white"
            android:tint="#DFF0E4" />

          <TextView
            android:id="@+id/rp_chip_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#2E7D46"
            android:textSize="11.5sp"
            android:textStyle="bold" />
        </FrameLayout>
      </LinearLayout>

      <LinearLayout
        android:id="@+id/rp_col_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
          android:layout_width="52dp"
          android:layout_height="52dp">

          <ImageView
            android:id="@+id/rp_img_2"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle_white" />

          <TextView
            android:id="@+id/rp_text_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        </FrameLayout>

        <TextView
          android:id="@+id/rp_name_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="5dp"
          android:ellipsize="end"
          android:gravity="center"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="14sp"
          android:textStyle="bold" />

        <FrameLayout
          android:layout_width="84dp"
          android:layout_height="24dp"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="5dp">

          <ImageView
            android:id="@+id/rp_chip_img_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_pill_white"
            android:tint="#DFF0E4" />

          <TextView
            android:id="@+id/rp_chip_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#2E7D46"
            android:textSize="11.5sp"
            android:textStyle="bold" />
        </FrameLayout>
      </LinearLayout>

      <FrameLayout
        android:id="@+id/rp_sp_2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
