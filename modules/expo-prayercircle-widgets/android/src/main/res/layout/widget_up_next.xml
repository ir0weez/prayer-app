<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next — wide. XML defaults are the quiet face ("Nothing left
     today"). The time wears its pill as a TextView background (a
     compiled drawable); the open-time line rides under a hairline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/next_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/widget_circle_white"
      android:tint="#A78BFA" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:letterSpacing="0.14"
      android:text="UP NEXT · TODAY"
      android:textColor="#AAA2C6"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/next_msg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="Nothing left today"
    android:textColor="#F4F1FD"
    android:textSize="16sp"
    android:textStyle="bold" />

  <LinearLayout
    android:id="@+id/next_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="top"
    android:orientation="horizontal"
    android:visibility="gone">

    <TextView
      android:id="@+id/next_time"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_pill_deep"
      android:paddingStart="11dp"
      android:paddingTop="5dp"
      android:paddingEnd="11dp"
      android:paddingBottom="5dp"
      android:textColor="#A78BFA"
      android:textSize="12sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/next_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#F4F1FD"
        android:textSize="17sp"
        android:textStyle="bold" />

      <TextView
        android:id="@+id/next_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="#D8D2F2"
        android:textSize="13sp" />
    </LinearLayout>
  </LinearLayout>

  <View
    android:id="@+id/next_divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="11dp"
    android:background="#3A2F63"
    android:visibility="gone" />

  <TextView
    android:id="@+id/next_then"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:textColor="#AAA2C6"
    android:textSize="12.5sp"
    android:visibility="gone" />
</LinearLayout>
