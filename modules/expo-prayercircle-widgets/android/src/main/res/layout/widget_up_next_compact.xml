<?xml version="1.0" encoding="utf-8"?>
<!-- Up Next — the DAY RAIL (W-6, Option A) at standard height:
     header, the hero band with its countdown, the gap after it,
     and the next item with the "· then N more" count. No done /
     NOW rows, no footer — the tall layout (widget_up_next)
     carries those. Header ids are shared with the full layout;
     the rows are fixed-purpose (nc_*). XML defaults are the
     quiet face in Classic-light values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/next_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/next_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_28"
    android:tint="#F7F3FE" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/next_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#6D4BD8" />

      <TextView
        android:id="@+id/next_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="UP NEXT · TODAY"
        android:textColor="#7A72A0"
        android:textSize="11sp"
        android:textStyle="bold" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <FrameLayout
        android:id="@+id/next_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <ImageView
          android:id="@+id/next_chip_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:id="@+id/next_left"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="10dp"
          android:paddingTop="4dp"
          android:paddingEnd="10dp"
          android:paddingBottom="4dp"
          android:textColor="#2A1666"
          android:textSize="12sp"
          android:textStyle="bold" />
      </FrameLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/next_msg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Nothing left today"
      android:textColor="#221A3E"
      android:textSize="16sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/nc_rows"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:orientation="vertical"
      android:visibility="gone">

      <!-- Hero row -->
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:layout_width="26dp"
          android:layout_height="match_parent"
          android:layout_marginStart="64dp"
          android:orientation="vertical">

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal">

            <ImageView
              android:id="@+id/nc_dot_h"
              android:layout_width="11dp"
              android:layout_height="11dp"
              android:layout_gravity="center"
              android:contentDescription="@null"
              android:src="@drawable/widget_circle_white"
              android:tint="#6D4BD8" />
          </FrameLayout>

          <ImageView
            android:id="@+id/nc_seg_h"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/widget_rail_seg" />
        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/nc_time_h"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#2A1666"
            android:textSize="11.5sp"
            android:textStyle="bold" />

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="1dp" />

          <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
              android:id="@+id/nc_band_img"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:contentDescription="@null"
              android:scaleType="fitXY"
              android:src="@drawable/widget_rounded16" />

            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingStart="12dp"
              android:paddingTop="10dp"
              android:paddingEnd="12dp"
              android:paddingBottom="10dp">

              <TextView
                android:id="@+id/nc_htitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#221A3E"
                android:textSize="20sp"
                android:textStyle="bold" />

              <TextView
                android:id="@+id/nc_hsub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#4A4270"
                android:textSize="13sp" />

              <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

              <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                  android:id="@+id/nc_hchip_img"
                  android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:contentDescription="@null"
                  android:scaleType="fitXY"
                  android:src="@drawable/widget_pill_white" />

                <TextView
                  android:id="@+id/nc_hcount"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:paddingStart="10dp"
                  android:paddingTop="5dp"
                  android:paddingEnd="10dp"
                  android:paddingBottom="5dp"
                  android:textColor="#6D4BD8"
                  android:textSize="12sp"
                  android:textStyle="bold" />
              </FrameLayout>
            </LinearLayout>
          </FrameLayout>
        </LinearLayout>
      </FrameLayout>

      <!-- Gap row -->
      <FrameLayout
        android:id="@+id/nc_row_gap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:layout_width="26dp"
          android:layout_height="match_parent"
          android:layout_marginStart="64dp"
          android:orientation="vertical">

          <ImageView
            android:id="@+id/nc_seg_g_top"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/widget_rail_seg" />

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal">

            <ImageView
              android:id="@+id/nc_dot_g"
              android:layout_width="7dp"
              android:layout_height="7dp"
              android:layout_gravity="center"
              android:contentDescription="@null"
              android:src="@drawable/widget_circle_white" />
          </FrameLayout>

          <ImageView
            android:id="@+id/nc_seg_g_bot"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/widget_rail_seg" />
        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

          <FrameLayout
            android:layout_width="64dp"
            android:layout_height="1dp" />

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="1dp" />

          <TextView
            android:id="@+id/nc_gap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="#7A72A0"
            android:textSize="12.5sp"
            android:textStyle="bold" />
        </LinearLayout>
      </FrameLayout>

      <!-- Next item row -->
      <FrameLayout
        android:id="@+id/nc_row_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
          android:layout_width="26dp"
          android:layout_height="match_parent"
          android:layout_marginStart="64dp"
          android:orientation="vertical">

          <ImageView
            android:id="@+id/nc_seg_i_top"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/widget_rail_seg" />

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal">

            <ImageView
              android:id="@+id/nc_dot_i"
              android:layout_width="11dp"
              android:layout_height="11dp"
              android:layout_gravity="center"
              android:contentDescription="@null"
              android:src="@drawable/widget_circle_white" />
          </FrameLayout>

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

          <TextView
            android:id="@+id/nc_time_i"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#7A72A0"
            android:textSize="11.5sp"
            android:textStyle="bold" />

          <FrameLayout
            android:layout_width="26dp"
            android:layout_height="1dp" />

          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
              android:id="@+id/nc_title_i"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:ellipsize="end"
              android:maxLines="1"
              android:textColor="#221A3E"
              android:textSize="14.5sp"
              android:textStyle="bold" />

            <TextView
              android:id="@+id/nc_sub_i"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="5dp"
              android:ellipsize="end"
              android:maxLines="1"
              android:textColor="#7A72A0"
              android:textSize="12.5sp"
              android:textStyle="bold" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
