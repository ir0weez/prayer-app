<?xml version="1.0" encoding="utf-8"?>
<!-- Your Fast — half-width. XML defaults are the quiet face ("No
     fast running"). Six fixed heart slots, tinted lit/resting by
     the provider; the whole row hides when the snapshot carries no
     XP state (hearts are never faked). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/fast_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:contentDescription="@null"
      android:src="@drawable/widget_circle_white"
      android:tint="#A78BFA" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:letterSpacing="0.14"
      android:text="YOUR FAST"
      android:textColor="#AAA2C6"
      android:textSize="11sp"
      android:textStyle="bold" />
  </LinearLayout>

  <TextView
    android:id="@+id/fast_msg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:text="No fast running"
    android:textColor="#F4F1FD"
    android:textSize="15sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/fast_day"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:textColor="#F4F1FD"
    android:textSize="32sp"
    android:textStyle="bold"
    android:visibility="gone" />

  <TextView
    android:id="@+id/fast_name"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:ellipsize="end"
    android:maxLines="2"
    android:textColor="#AAA2C6"
    android:textSize="12sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/fast_hearts"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:orientation="horizontal"
    android:visibility="gone">

    <ImageView
      android:id="@+id/fast_heart_1"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="4dp"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/fast_heart_2"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="4dp"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/fast_heart_3"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/fast_heart_4"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/fast_heart_5"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:layout_marginEnd="4dp"
      android:contentDescription="@null" />

    <ImageView
      android:id="@+id/fast_heart_6"
      android:layout_width="16dp"
      android:layout_height="16dp"
      android:contentDescription="@null" />
  </LinearLayout>
</LinearLayout>
