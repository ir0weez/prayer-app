<?xml version="1.0" encoding="utf-8"?>
<!-- Your Study — v442 redesign (W-4 D-6). The card wears the
     effective palette's surface; the BOOK's ROYGBIV colour (a
     meaning hue, from the snapshot — never the palette) survives
     on the header dot, the book tile and the progress bar. The
     bar is an ImageView drawn in-process (barBitmap). The tile
     is the squarer 16dp-radius shape (Expressive steer). XML
     defaults are the quiet face in the Classic-light values. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/study_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/study_bg_img"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white_28"
    android:tint="#F7F3FE" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/study_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#C23B2E" />

      <TextView
        android:id="@+id/study_kicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="YOUR STUDY"
        android:textColor="#7A72A0"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/study_msg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="No book underway"
      android:textColor="#221A3E"
      android:textSize="16sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/study_main"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="13dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <ImageView
          android:id="@+id/study_tile"
          android:layout_width="54dp"
          android:layout_height="54dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_rounded16" />

        <ImageView
          android:id="@+id/study_book_glyph"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="center"
          android:contentDescription="@null" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/study_book"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#221A3E"
          android:textSize="23sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/study_next"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:textColor="#4A4270"
          android:textSize="13.5sp" />
      </LinearLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
          android:id="@+id/study_prog"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="end"
          android:textColor="#221A3E"
          android:textSize="16sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/study_prog_sub"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="end"
          android:textColor="#7A72A0"
          android:textSize="11sp"
          android:textStyle="bold" />
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/study_last"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:layout_marginTop="12dp"
      android:maxLines="1"
      android:textColor="#4A4270"
      android:textSize="13.5sp"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/study_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="13dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:id="@+id/study_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp">

        <ImageView
          android:id="@+id/study_pill_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:id="@+id/study_pill_text"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:gravity="center"
          android:paddingStart="18dp"
          android:paddingEnd="18dp"
          android:text="Open chapter"
          android:textColor="#2A1666"
          android:textSize="14sp"
          android:textStyle="bold" />
      </FrameLayout>

      <ImageView
        android:id="@+id/study_bar"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:contentDescription="@null"
        android:scaleType="fitXY" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
