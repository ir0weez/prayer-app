<?xml version="1.0" encoding="utf-8"?>
<!-- Your Study — wide, in the current book's colour. The root is a
     tint layer: a white rounded-rect ImageView painted with the
     book's dark tint via setColorFilter (default #2C2140 in XML),
     the content over it. XML defaults are the quiet face ("No book
     underway"). Rows beyond the verse (last written / restudy) are
     fixed slots the provider hides when the snapshot carries none
     — or when the placed height is too short to hold them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/study_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ImageView
    android:id="@+id/study_bg_img"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@null"
    android:scaleType="fitXY"
    android:src="@drawable/widget_shape_white"
    android:tint="#2C2140" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/study_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_circle_white"
        android:tint="#A78BFA" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:letterSpacing="0.14"
        android:text="YOUR STUDY"
        android:textColor="#DDD6F5"
        android:textSize="11sp"
        android:textStyle="bold" />
    </LinearLayout>

    <TextView
      android:id="@+id/study_msg"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="No book underway"
      android:textColor="#F4F1FD"
      android:textSize="16sp"
      android:textStyle="bold" />

    <LinearLayout
      android:id="@+id/study_main"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="top"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp">

        <ImageView
          android:id="@+id/study_tile"
          android:layout_width="46dp"
          android:layout_height="46dp"
          android:contentDescription="@null"
          android:src="@drawable/widget_tile_white" />

        <ImageView
          android:id="@+id/study_book_glyph"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="center"
          android:contentDescription="@null" />
      </FrameLayout>

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/study_book"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#F4F1FD"
          android:textSize="18sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/study_next"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="1dp"
          android:textColor="#DDD6F5"
          android:textSize="13sp" />
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/study_verse"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="#EDE9FA"
      android:textSize="13.5sp"
      android:textStyle="italic"
      android:visibility="gone" />

    <TextView
      android:id="@+id/study_last"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:layout_marginTop="6dp"
      android:maxLines="1"
      android:textColor="#AAA2C6"
      android:textSize="12.5sp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/study_restudy"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:layout_marginTop="3dp"
      android:maxLines="1"
      android:textColor="#AAA2C6"
      android:textSize="12.5sp"
      android:visibility="gone" />

    <LinearLayout
      android:id="@+id/study_footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:visibility="gone">

      <FrameLayout
        android:id="@+id/study_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
          android:id="@+id/study_pill_img"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:contentDescription="@null"
          android:scaleType="fitXY"
          android:src="@drawable/widget_pill_white" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="15dp"
          android:paddingTop="8dp"
          android:paddingEnd="15dp"
          android:paddingBottom="8dp"
          android:text="Open chapter"
          android:textColor="#FFFFFF"
          android:textSize="12.5sp"
          android:textStyle="bold" />
      </FrameLayout>

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

      <TextView
        android:id="@+id/study_prog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#AAA2C6"
        android:textSize="12sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
