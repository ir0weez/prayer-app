<?xml version="1.0" encoding="utf-8"?>
<!-- v462: the Daily Breakdown (DB-9, the Brief List) — a tall
     list card: targetCell 4x3 so all four rows seat at the
     standard placement. Smaller heights seat fewer rows whole
     under the renderer's budget — never a clipped row. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="320dp"
  android:minHeight="210dp"
  android:targetCellWidth="4"
  android:targetCellHeight="3"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/widget_daily_breakdown"
  android:previewLayout="@layout/widget_daily_breakdown"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen" />
