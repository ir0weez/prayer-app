<?xml version="1.0" encoding="utf-8"?>
<!-- v438: provider info for the native widget. Sizes/labels/descriptions
     carried over unchanged from the v437 registration; the OS refresh
     sits at Android's 30-minute floor so countdowns re-render from the
     stored snapshot without the app waking. initialLayout IS the first
     render — the compiled layout's defaults are the quiet face, so a
     fresh placement can never be blank. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="320dp"
  android:minHeight="130dp"
  android:targetCellWidth="4"
  android:targetCellHeight="2"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/widget_up_next"
  android:previewLayout="@layout/widget_up_next"
  android:description="@string/widget_up_next_desc"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen" />
